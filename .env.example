# BakaStream web — environment contract
#
# Copy to `.env.local` for local development. Never commit real secrets.
# All metadata (TMDB) and playback resolution happen SERVER-SIDE: none of
# these values are shipped to the browser, keeping credentials completely safe.

# ── Required ────────────────────────────────────────────────────────────────
# TMDB credentials — one of the two must be set. Prefer the v4 access token.
#   https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# Base URL of the TMDB API (default: https://api.themoviedb.org/3)
TMDB_BASE_URL=

# Absolute site URL used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://bakastream.vercel.app

# Stream provider. Leave empty to run with the built-in legal preview player
# (public sample streams, clearly labeled in the UI). When set, the Nova
# adapter resolves playback through this deployment's NovaAPI instance.
#   https://github.com/ProYato/NovaAPI
# NOTE: Nova is an unverified third party — a URL it returns is NOT proof of
# licensing. Only point this at streams you are authorized to serve.
NOVA_API_URL=http://localhost:5001

# Google Analytics (GA4). Omit to disable analytics entirely.
NEXT_PUBLIC_GA_TRACKING_ID=

# ── True runtime variables (standalone container server) ────────────────────
# PORT      — listen port, default 3000
# HOSTNAME  — bind address, default 0.0.0.0
